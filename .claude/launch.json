{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "burgertone-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    },
    {
      "name": "burgertone-preview",
      "runtimeExecutable": "npm",
